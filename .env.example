# Optional Cloudflare rescue/status service. Local WeChat works without it.
WECHAT_RESCUE_ENABLED=false
# Required only when enabled. Comma-separated exact owner emails, no wildcards.
WECHAT_RESCUE_ALLOWED_EMAILS=owner@example.com,backup@example.com
WECHAT_RESCUE_HOSTNAME=rescue.example.com
WECHAT_RESCUE_ZONE=example.com
WECHAT_RESCUE_ACCESS_TEAM=your-access-team
WECHAT_RESCUE_DEVICE_ID=my-computer
WECHAT_RESCUE_WORKER_NAME=wechat-rescue
WECHAT_RESCUE_DATABASE_NAME=wechat-rescue
# Optional: default is ~/.local/share/wechat-agent/health.json
# WECHAT_RESCUE_STATE_PATH=/absolute/path/to/health.json
# Required for standalone heartbeat; installer discovers this by database name.
# WECHAT_RESCUE_DATABASE_ID=
# Cloudflare API access; alternatively pass --credentials /private/file.env.sops.
# WECHAT_RESCUE_CREDENTIALS_FILE=/stable/private/cloudflare.env.sops
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Enabling status monitoring does NOT enable experimental remote QR capture.
